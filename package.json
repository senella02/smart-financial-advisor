{
  "name": "smart-financial-advisor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": "26.13.0", "pnpm": "12.18.0" },
  "scripts": {
    "dev": "pnpm --filter @sfa/web dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @sfa/web exec next typegen && tsc --noEmit && pnpm --filter @sfa/web typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @sfa/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  }
}
